<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Maqloub.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="420"
        Height="660"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        x:Class="Maqloub.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Maqloub">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid Margin="24">

        <Border
            Width="340"
            Background="#1E1E1E"
            CornerRadius="24"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Spacing="24">

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Maqloub"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"/>

                    <TextBlock
                        Text="Flip wrong keyboard typing instantly"
                        FontSize="14"
                        Foreground="#AFAFAF"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"/>

                </StackPanel>

                <StackPanel Spacing="8">

                    <TextBlock
                        Text="First keyboard layout"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"/>

                    <ComboBox
                        x:Name="FirstLanguageComboBox"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        Background="#292929"
                        Foreground="White"
                        BorderBrush="#454545"
                        BorderThickness="1"
                        FontSize="14"
                        PlaceholderText="Select first layout">

                        <ComboBoxItem Content="Arabic"/>
                        <ComboBoxItem Content="English"/>

                    </ComboBox>

                </StackPanel>

                <StackPanel Spacing="8">

                    <TextBlock
                        Text="Second keyboard layout"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"/>

                    <ComboBox
                        x:Name="SecondLanguageComboBox"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        Background="#292929"
                        Foreground="White"
                        BorderBrush="#454545"
                        BorderThickness="1"
                        FontSize="14"
                        PlaceholderText="Select second layout">

                        <ComboBoxItem Content="Arabic"/>
                        <ComboBoxItem Content="English"/>

                    </ComboBox>

                </StackPanel>

                <StackPanel Spacing="8">

                    <TextBlock
                        Text="Keyboard shortcut"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#E5E5E5"/>

                    <TextBox
                        x:Name="ShortcutTextBox"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        Background="#292929"
                        Foreground="White"
                        BorderBrush="#454545"
                        BorderThickness="1"
                        FontSize="14"
                        IsReadOnly="True"
                        PlaceholderText="Press Ctrl, Alt or Shift with a key"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        KeyDown="ShortcutTextBox_KeyDown"/>

                </StackPanel>

                <CheckBox
                    x:Name="StartWithWindowsCheckBox"
                    Content="Start Maqloub with Windows"
                    Foreground="#E5E5E5"
                    FontSize="14"
                    HorizontalAlignment="Left"/>

                <StackPanel Spacing="12">

                    <Button
                        x:Name="StartButton"
                        Content="Save &amp; Run"
                        Height="46"
                        HorizontalAlignment="Stretch"
                        Background="#6C63FF"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="StartButton_Click"/>

                    <TextBlock
                        x:Name="StatusTextBlock"
                        Text=""
                        Foreground="#79D98C"
                        FontSize="13"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Stretch"
                        IsVisible="False"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>